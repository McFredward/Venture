diff --git a/include/EGL/eglext_angle_venture.h b/include/EGL/eglext_angle_venture.h
new file mode 100644
index 0000000..4551e62
--- /dev/null
+++ b/include/EGL/eglext_angle_venture.h
@@ -0,0 +1,39 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef INCLUDE_EGL_EGLEXT_ANGLE_VENTURE_H_
+#define INCLUDE_EGL_EGLEXT_ANGLE_VENTURE_H_
+
+#include <stdint.h>
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <EGL/eglext_angle.h>
+#include <vulkan/vulkan_core.h>
+
+#define EGL_VULKAN_CREATION_CALLBACKS_VERSION_VENTURE 1
+
+// Host C ABI, never a guest callback table. See
+// extensions/EGL_VENTURE_vulkan_creation_callbacks.txt for ownership and lifetime.
+typedef struct EGLVulkanCreationCallbacksVENTURE
+{
+    uint32_t version;
+    uint32_t size;
+    void *userData;
+    VkResult (VKAPI_PTR *createInstance)(void *userData, PFN_vkGetInstanceProcAddr loader,
+                                        const VkInstanceCreateInfo *info,
+                                        const VkAllocationCallbacks *allocator,
+                                        VkInstance *instance);
+    VkResult (VKAPI_PTR *choosePhysicalDevice)(void *userData, PFN_vkGetInstanceProcAddr loader,
+                                              VkInstance instance, uint32_t deviceCount,
+                                              const VkPhysicalDevice *devices,
+                                              VkPhysicalDevice *physicalDevice);
+    VkResult (VKAPI_PTR *createDevice)(void *userData, PFN_vkGetInstanceProcAddr loader,
+                                      VkInstance instance, VkPhysicalDevice physicalDevice,
+                                      const VkDeviceCreateInfo *info,
+                                      const VkAllocationCallbacks *allocator, VkDevice *device);
+    void (VKAPI_PTR *deviceReady)(void *userData, VkInstance instance,
+                                  VkPhysicalDevice physicalDevice, VkDevice device,
+                                  uint32_t queueFamily, uint32_t queueIndex, VkQueue queue);
+} EGLVulkanCreationCallbacksVENTURE;
+
+#endif  // INCLUDE_EGL_EGLEXT_ANGLE_VENTURE_H_
